{
  "manifest_version": 3,
  "name": "Brave Mini Lyrics (PiP)",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "description": "Menampilkan lirik melayang tersinkronisasi untuk video musik YouTube menggunakan Document PiP.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Buka/Tutup Jendela Lirik",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://lrclib.net/*",
    "https://translate.googleapis.com/*",
    "https://music.163.com/*",
    "https://c.y.qq.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "kuroshiro.min.js",
        "kuroshiro-analyzer-kuromoji.min.js",
        "lib/lrc.js",
        "lib/kana.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dict/*",
        "pip.css"
      ],
      "matches": [
        "https://*.youtube.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-lyrics": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Buka/tutup jendela lirik"
    }
  }
}
